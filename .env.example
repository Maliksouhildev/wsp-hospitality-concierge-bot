# WhatsApp Cloud API / Meta Graph API
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_access_token
META_WA_VERIFY_TOKEN=your_meta_webhook_verify_token

# Hospitable.com PMS API
HOSPITABLE_API_KEY=your_hospitable_api_key
HOSPITABLE_CLIENT_ID=your_hospitable_client_id

# OpenAI API Key (GPT-4o & Embeddings)
OPENAI_API_KEY=sk-...

# Qdrant Vector Database (Apartment Catalog & FAQs)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_api_key

# Redis (Session Locks, Rate Limiting & Memory)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# HubSpot CRM API Key (Lead Sync)
HUBSPOT_API_KEY=your_hubspot_api_key

# Google Sheets Configuration
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
